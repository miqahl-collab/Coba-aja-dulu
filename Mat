<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Matematika Kelas 12 | Platform Belajar Profesional</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>
  <style>
    :root {
      --bg: #F8FAFC;
      --card: #FFFFFF;
      --text: #1E293B;
      --text-muted: #64748B;
      --primary: #2563EB;
      --primary-soft: #EFF6FF;
      --accent: #0EA5E9;
      --success: #10B981;
      --warning: #F59E0B;
      --danger: #EF4444;
      --border: #E2E8F0;
      --shadow: 0 1px 3px rgba(15,23,42,0.06), 0 4px 12px rgba(15,23,42,0.04);
      --radius: 14px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      font-size: 16px;
    }
    h1, h2, h3, h4, h5 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 700;
      line-height: 1.3;
      color: #0F172A;
    }
    a { color: var(--primary); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* Layout */
    .app {
      display: grid;
      grid-template-columns: 280px 1fr;
      min-height: 100vh;
    }
    @media (max-width: 900px) {
      .app { grid-template-columns: 1fr; }
      .sidebar { position: fixed; left: -300px; top: 0; bottom: 0; z-index: 100; transition: left .25s; }
      .sidebar.open { left: 0; }
      .overlay { display: none; position: fixed; inset: 0; background: rgba(15,23,42,.4); z-index: 99; }
      .overlay.show { display: block; }
    }

    /* Sidebar */
    .sidebar {
      background: #0F172A;
      color: #E2E8F0;
      padding: 1.5rem 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
    }
    .brand {
      padding: 0.5rem 0.75rem 1.25rem;
      border-bottom: 1px solid #1E293B;
      margin-bottom: 0.75rem;
    }
    .brand h1 {
      font-size: 1.15rem;
      color: #F8FAFC;
      letter-spacing: -0.02em;
    }
    .brand p {
      font-size: 0.78rem;
      color: #94A3B8;
      margin-top: 0.25rem;
    }
    .nav-item {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.7rem 0.85rem;
      border-radius: 10px;
      color: #CBD5E1;
      font-size: 0.92rem;
      font-weight: 500;
      cursor: pointer;
      transition: all .15s;
      border: none;
      background: transparent;
      width: 100%;
      text-align: left;
    }
    .nav-item:hover { background: #1E293B; color: #F8FAFC; }
    .nav-item.active {
      background: var(--primary);
      color: white;
    }
    .nav-item .num {
      width: 24px; height: 24px;
      border-radius: 6px;
      background: rgba(255,255,255,.12);
      display: grid; place-items: center;
      font-size: 0.75rem;
      font-weight: 700;
    }
    .nav-item.active .num { background: rgba(255,255,255,.25); }

    /* Main */
    .main {
      padding: 1.5rem 1.75rem 3rem;
      max-width: 920px;
      width: 100%;
      margin: 0 auto;
    }
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
      gap: 1rem;
    }
    .menu-btn {
      display: none;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 0.5rem 0.75rem;
      cursor: pointer;
      font-size: 1.1rem;
    }
    @media (max-width: 900px) {
      .menu-btn { display: inline-flex; }
    }

    /* Cards & sections */
    .card {
      background: var(--card);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      border: 1px solid var(--border);
      padding: 1.5rem 1.6rem;
      margin-bottom: 1.25rem;
    }
    .section-title {
      font-size: 1.55rem;
      margin-bottom: 0.35rem;
    }
    .section-sub {
      color: var(--text-muted);
      font-size: 0.95rem;
      margin-bottom: 1.25rem;
    }
    .subhead {
      font-size: 1.15rem;
      margin: 1.6rem 0 0.7rem;
      padding-bottom: 0.35rem;
      border-bottom: 2px solid var(--primary-soft);
      color: #1E40AF;
    }
    .philosophy {
      background: linear-gradient(135deg, #EFF6FF 0%, #F0F9FF 100%);
      border-left: 4px solid var(--primary);
      padding: 1rem 1.15rem;
      border-radius: 0 12px 12px 0;
      margin: 1rem 0 1.25rem;
      font-size: 0.95rem;
    }
    .philosophy strong { color: #1E40AF; }

    /* Formula box */
    .formula {
      background: #F1F5F9;
      border: 1px solid #CBD5E1;
      border-radius: 12px;
      padding: 1rem 1.25rem;
      margin: 1rem 0;
      text-align: center;
      overflow-x: auto;
    }
    .formula .label {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 0.4rem;
    }

    /* Example cards */
    .example {
      background: #FAFBFC;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.15rem 1.25rem;
      margin: 1.1rem 0;
    }
    .example .tag {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      padding: 0.2rem 0.55rem;
      border-radius: 6px;
      margin-bottom: 0.5rem;
    }
    .tag.dasar { background: #DCFCE7; color: #166534; }
    .tag.menengah { background: #FEF3C7; color: #92400E; }
    .tag.lanjut { background: #E0E7FF; color: #3730A3; }
    .tag.hots { background: #FEE2E2; color: #991B1B; }
    .example h4 { font-size: 1rem; margin-bottom: 0.5rem; }
    .pembahasan {
      margin-top: 0.75rem;
      padding-top: 0.75rem;
      border-top: 1px dashed var(--border);
      font-size: 0.94rem;
    }
    .pembahasan strong { color: #0F766E; }

    /* Real world */
    .real-world {
      background: #ECFDF5;
      border: 1px solid #A7F3D0;
      border-radius: 12px;
      padding: 1rem 1.2rem;
      margin: 1.25rem 0;
    }
    .real-world h4 {
      font-size: 0.95rem;
      color: #065F46;
      margin-bottom: 0.4rem;
    }

    /* SVG container */
    .viz {
      background: #FFFFFF;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1rem;
      margin: 1.25rem 0;
      text-align: center;
      overflow-x: auto;
    }
    .viz svg { max-width: 100%; height: auto; }
    .viz .caption {
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-top: 0.6rem;
    }

    /* Quiz */
    .quiz-wrap { display: none; }
    .quiz-wrap.active { display: block; }
    .quiz-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }
    .q-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .q-btn {
      width: 36px; height: 36px;
      border-radius: 8px;
      border: 1.5px solid var(--border);
      background: white;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all .15s;
      color: var(--text);
    }
    .q-btn:hover { border-color: var(--primary); color: var(--primary); }
    .q-btn.current { background: var(--primary); color: white; border-color: var(--primary); }
    .q-btn.answered { background: #DBEAFE; border-color: #93C5FD; color: #1E40AF; }
    .q-btn.correct { background: #D1FAE5; border-color: #6EE7B7; color: #065F46; }
    .q-btn.wrong { background: #FEE2E2; border-color: #FCA5A5; color: #991B1B; }

    .question-card {
      background: var(--card);
      border-radius: var(--radius);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      padding: 1.4rem 1.5rem;
      margin-bottom: 1rem;
    }
    .q-num {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--primary);
      margin-bottom: 0.4rem;
    }
    .options { margin-top: 1rem; display: flex; flex-direction: column; gap: 0.55rem; }
    .opt {
      display: flex;
      align-items: flex-start;
      gap: 0.7rem;
      padding: 0.75rem 1rem;
      border: 1.5px solid var(--border);
      border-radius: 10px;
      cursor: pointer;
      transition: all .15s;
      background: white;
    }
    .opt:hover { border-color: #93C5FD; background: #F8FAFC; }
    .opt.selected { border-color: var(--primary); background: var(--primary-soft); }
    .opt.correct-opt { border-color: var(--success); background: #ECFDF5; }
    .opt.wrong-opt { border-color: var(--danger); background: #FEF2F2; }
    .opt input { margin-top: 0.2rem; accent-color: var(--primary); }
    .opt label { cursor: pointer; flex: 1; font-size: 0.95rem; }

    .quiz-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 1.25rem;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.65rem 1.2rem;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.92rem;
      border: none;
      cursor: pointer;
      transition: all .15s;
      font-family: inherit;
    }
    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: #1D4ED8; }
    .btn-outline {
      background: white;
      border: 1.5px solid var(--border);
      color: var(--text);
    }
    .btn-outline:hover { border-color: var(--primary); color: var(--primary); }
    .btn-success { background: var(--success); color: white; }
    .btn:disabled { opacity: 0.55; cursor: not-allowed; }

    .result-box {
      background: linear-gradient(135deg, #ECFDF5, #F0FDF4);
      border: 1px solid #A7F3D0;
      border-radius: 12px;
      padding: 1.25rem 1.4rem;
      margin: 1.25rem 0;
      text-align: center;
    }
    .result-box .score {
      font-size: 2.2rem;
      font-weight: 800;
      color: #065F46;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .explanation {
      background: #F8FAFC;
      border-left: 3px solid var(--primary);
      padding: 0.85rem 1rem;
      margin-top: 0.9rem;
      border-radius: 0 8px 8px 0;
      font-size: 0.92rem;
    }

    /* Home */
    .home-hero {
      text-align: center;
      padding: 2rem 1rem 1.5rem;
    }
    .home-hero h2 {
      font-size: 1.85rem;
      margin-bottom: 0.5rem;
    }
    .home-hero p {
      color: var(--text-muted);
      max-width: 520px;
      margin: 0 auto 1.5rem;
    }
    .chapters-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1rem;
    }
    .chap-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.25rem;
      cursor: pointer;
      transition: all .2s;
      box-shadow: var(--shadow);
    }
    .chap-card:hover {
      border-color: #93C5FD;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(37,99,235,0.12);
    }
    .chap-card .num {
      width: 36px; height: 36px;
      background: var(--primary-soft);
      color: var(--primary);
      border-radius: 10px;
      display: grid; place-items: center;
      font-weight: 800;
      font-size: 1rem;
      margin-bottom: 0.75rem;
    }
    .chap-card h3 { font-size: 1.05rem; margin-bottom: 0.35rem; }
    .chap-card p { font-size: 0.85rem; color: var(--text-muted); }

    .hidden { display: none !important; }
    .katex { font-size: 1.05em; }
    ul, ol { padding-left: 1.35rem; margin: 0.5rem 0; }
    li { margin: 0.25rem 0; }
    p { margin: 0.55rem 0; }
    .note {
      font-size: 0.88rem;
      color: var(--text-muted);
      font-style: italic;
    }
  </style>
</head>
